    "sections": {
      "administracao_preparo": {
        "pt": [
          {
            "label": "Reconstituição",
            "text": "Reconstituir o frasco de 500 mg com 10 mL de Água Estéril para Injeção, obtendo 50 mg/mL. Não utilizar outro diluente nessa etapa, pois pode ocorrer precipitação."
          },
          {
            "label": "Diluição",
            "text": "Após reconstituição, diluir em SF 0,9%, Ringer lactato ou Normosol-R. Para infusão contínua, preparar concentração final de 1 mg/mL; para infusão intermitente, 1–5 mg/mL."
          },
          {
            "label": "Infusão IV",
            "text": "Não administrar por IV push. Na infusão intermitente, administrar em 20–60 minutos; a solução final diluída deve ser utilizada em até 8 horas."
          }
        ],
        "es": [
          {
            "label": "Reconstitución",
            "text": "Reconstituir el vial de 500 mg con 10 mL de Agua Estéril para Inyección, obteniendo 50 mg/mL. No utilizar otro diluyente en esta etapa, ya que puede producirse precipitación."
          },
          {
            "label": "Dilución",
            "text": "Después de reconstituir, diluir en SF 0,9%, Ringer lactato o Normosol-R. Para infusión continua, preparar una concentración final de 1 mg/mL; para infusión intermitente, 1–5 mg/mL."
          },
          {
            "label": "Infusión IV",
            "text": "No administrar mediante IV push. En infusión intermitente, administrar durante 20–60 minutos; la solución final diluida debe utilizarse dentro de 8 horas."
          }
        ]
      },
