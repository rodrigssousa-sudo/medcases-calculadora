      "alertas_criticos": {
        "pt": [
          {
            "label": "Alerta principal",
            "text": "Na asma, formoterol deve estar associado a ICS. O uso de LABA sem ICS aumenta risco de eventos graves."
          },
          {
            "label": "Eventos graves",
            "text": "Taquiarritmia; Hipocalemia; Broncoespasmo paradoxal"
          }
        ],
        "es": [
          {
            "label": "Alerta principal",
            "text": "En asma, formoterol debe asociarse a ICS. El uso de LABA sin ICS aumenta riesgo de eventos graves."
          },
          {
            "label": "Eventos graves",
            "text": "Taquiarritmia; Hipopotasemia; Broncoespasmo paradójico"
          }
        ]
      },
      "usos_especiais": {
        "pt": [
          {
            "label": "Adulto",
            "text": "Solução inalatória para DPOC: 20 mcg por nebulização a cada 12 h. Em asma, dose depende da combinação ICS-formoterol e do regime prescrito."
          },
          {
            "label": "Pediatria",
            "text": "Uso em asma pediátrica deve seguir a combinação ICS-formoterol, idade e dispositivo autorizados."
          },
          {
            "label": "Rim",
            "text": "Sem ajuste renal rotineiro."
          },
          {
            "label": "Fígado",
            "text": "Sem ajuste hepático rotineiro definido."
          }
        ],
        "es": [
          {
            "label": "Adulto",
            "text": "Solución inhalatoria para EPOC: 20 mcg por nebulización cada 12 h. En asma, la dosis depende de la combinación ICS-formoterol y del régimen prescrito."
          },
          {
            "label": "Pediatría",
            "text": "Uso en asma pediátrica debe seguir combinación ICS-formoterol, edad y dispositivo autorizados."
          },
          {
            "label": "Riñón",
            "text": "Sin ajuste renal rutinario."
          },
          {
            "label": "Hígado",
            "text": "Sin ajuste hepático rutinario definido."
          }
        ]
      },
      "dados_farmacologicos": {
        "pt": [
          {
            "label": "Classe",
            "text": "Agonista β2 de longa ação (LABA) de início rápido"
          },
          {
            "label": "Mecanismo",
            "text": "Agonismo β2 prolongado relaxa músculo liso brônquico; início relativamente rápido."
          },
          {
            "label": "Indicações",
            "text": "Manutenção da DPOC; Em asma, somente em combinação com ICS; ICS-formoterol pode ser usado em regimes AIR/MART conforme GINA 2026 e produto"
          }
        ],
        "es": [
          {
            "label": "Clase",
            "text": "Agonista β2 de acción prolongada (LABA) de inicio rápido"
          },
          {
            "label": "Mecanismo",
            "text": "Agonismo β2 prolongado relaja músculo liso bronquial; inicio relativamente rápido."
          },
          {
            "label": "Indicaciones",
            "text": "Mantenimiento de EPOC; En asma, solo en combinación con ICS; ICS-formoterol puede usarse en regímenes AIR/MART según GINA 2026 y producto"
          }
        ]
