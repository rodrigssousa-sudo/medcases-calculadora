    "sections": {
      "administracao_preparo": {
        "pt": [
          {
            "label": "Reconstituição",
            "text": "Reconstituir conforme via e apresentação. Para IV, a rotulagem consultada descreve 10 mL de diluente para frascos de 500 mg, 1 g ou 2 g; para IM, são utilizados volumes menores específicos por apresentação."
          },
          {
            "label": "Preparo",
            "text": "Agitar até dissolução completa. A solução pode variar de amarelo muito pálido a âmbar claro conforme concentração, diluente e armazenamento."
          },
          {
            "label": "Inspeção",
            "text": "Inspecionar visualmente a solução quanto a partículas e alteração de cor antes da administração."
          }
        ],
        "es": [
          {
            "label": "Reconstitución",
            "text": "Reconstituir según la vía y la presentación. Para IV, el rotulado consultado describe 10 mL de diluyente para viales de 500 mg, 1 g o 2 g; para IM se utilizan volúmenes menores específicos de cada presentación."
          },
          {
            "label": "Preparación",
            "text": "Agitar hasta la disolución completa. La solución puede variar de amarillo muy pálido a ámbar claro según la concentración, el diluyente y el almacenamiento."
          },
          {
            "label": "Inspección",
            "text": "Inspeccionar visualmente la solución para detectar partículas y cambios de color antes de administrar."
          }
        ]
      },
