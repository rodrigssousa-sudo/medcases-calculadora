    "sections": {
      "administracao_preparo": {
        "pt": [
          {
            "label": "Infusão IV",
            "text": "A apresentação premisturada de 500 mg/100 mL (5 mg/mL) é destinada exclusivamente à infusão intravenosa lenta, contínua ou intermitente."
          },
          {
            "label": "Não adicionar medicamentos",
            "text": "Não introduzir aditivos na bolsa e evitar misturas IV contendo metronidazol com outros fármacos."
          },
          {
            "label": "Linha primária",
            "text": "Quando utilizada em sistema com fluido IV primário, interromper a solução primária durante a infusão do metronidazol conforme a rotulagem da apresentação."
          }
        ],
        "es": [
          {
            "label": "Infusión IV",
            "text": "La presentación premezclada de 500 mg/100 mL (5 mg/mL) está destinada exclusivamente a infusión intravenosa lenta, continua o intermitente."
          },
          {
            "label": "No agregar medicamentos",
            "text": "No introducir aditivos en la bolsa y evitar mezclas IV que contengan metronidazol con otros fármacos."
          },
          {
            "label": "Línea primaria",
            "text": "Cuando se utilice en un sistema con fluido IV primario, interrumpir la solución primaria durante la infusión de metronidazol según el rotulado de la presentación."
          }
        ]
      },
