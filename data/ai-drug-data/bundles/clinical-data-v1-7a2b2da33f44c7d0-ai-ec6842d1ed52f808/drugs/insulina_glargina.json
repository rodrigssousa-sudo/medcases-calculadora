        "sections": {
          "administracao_preparo": {
            "es": [
              {
                "label": "Vía SC",
                "text": "Administrar exclusivamente por vía subcutánea en abdomen, muslo o brazo, manteniendo un horario consistente y rotando los puntos de aplicación dentro de la misma región."
              },
              {
                "label": "No mezclar / no diluir",
                "text": "No administrar por vía intravenosa ni mediante bomba de insulina. No mezclar ni diluir con otras insulinas o soluciones, ya que puede alterarse el perfil de acción."
              },
              {
                "label": "Inspección",
                "text": "Usar solo si la solución está límpida, incolora y sin partículas visibles."
              }
            ],
            "pt": [
              {
                "label": "Via SC",
                "text": "Administrar exclusivamente por via subcutânea no abdome, coxa ou braço, mantendo horário consistente e realizando rodízio dos pontos de aplicação dentro da mesma região."
              },
              {
                "label": "Não misturar / não diluir",
                "text": "Não administrar por via intravenosa nem em bomba de insulina. Não misturar ou diluir com outras insulinas ou soluções, pois isso pode alterar o perfil de ação."
              },
              {
                "label": "Inspeção",
                "text": "Usar somente se a solução estiver límpida, incolor e sem partículas visíveis."
              }
            ]
