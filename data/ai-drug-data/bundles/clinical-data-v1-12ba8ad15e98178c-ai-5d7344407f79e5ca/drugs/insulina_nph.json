        "sections": {
          "administracao_preparo": {
            "es": [
              {
                "label": "Homogeneización",
                "text": "Antes de la aplicación, hacer rodar suavemente el vial o la pluma entre las manos 10 veces e invertir 10 veces. Después de homogeneizar, la suspensión debe quedar uniformemente blanca y turbia; no usar si permanece límpida o presenta grumos/partículas."
              },
              {
                "label": "Vía SC",
                "text": "Administrar solo por vía subcutánea en abdomen, muslo, brazo o glúteo, rotando los sitios de inyección."
              },
              {
                "label": "Evitar IV / bomba",
                "text": "No administrar por vía intravenosa y no utilizar en bomba de infusión de insulina."
              }
            ],
            "pt": [
              {
                "label": "Homogeneização",
                "text": "Antes da aplicação, rolar suavemente o frasco ou a caneta entre as mãos 10 vezes e inverter 10 vezes. Após a homogeneização, a suspensão deve ficar uniformemente branca e turva; não usar se permanecer límpida ou apresentar grumos/partículas."
              },
              {
                "label": "Via SC",
                "text": "Administrar somente por via subcutânea em abdome, coxa, braço ou nádega, realizando rodízio dos locais de injeção."
              },
              {
                "label": "Evitar IV / bomba",
                "text": "Não administrar por via intravenosa e não utilizar em bomba de infusão de insulina."
              }
            ]
          },
