        "schema": "medcases.clinical-enrichment.v1",
        "sections": {
          "administracao_preparo": {
            "es": [
              {
                "label": "Técnica SC",
                "text": "Administrar mediante inyección subcutánea profunda según la presentación. Para la aplicación subcutánea, mantener al paciente en decúbito y utilizar una técnica adecuada en el tejido adiposo abdominal."
              },
              {
                "label": "Jeringa precargada",
                "text": "No expulsar la burbuja de aire de la jeringa precargada antes de la inyección, para evitar pérdida del medicamento. No aplicar sobre zonas con equimosis o cicatrices y no inyectar a través de la ropa."
              },
              {
                "label": "Rotación de sitios",
                "text": "Alternar los sitios de aplicación entre las paredes abdominales anterolateral y posterolateral, derecha e izquierda."
              }
            ],
            "pt": [
              {
                "label": "Técnica SC",
                "text": "Administrar por injeção subcutânea profunda conforme a apresentação. Para a aplicação subcutânea, manter o paciente em decúbito e utilizar técnica apropriada no tecido adiposo abdominal."
              },
              {
                "label": "Seringa pré-cheia",
                "text": "Não expulsar a bolha de ar da seringa pré-cheia antes da injeção, para evitar perda de medicamento. Não aplicar sobre áreas com equimoses ou cicatrizes e não injetar através da roupa."
              },
              {
                "label": "Rodízio de sítios",
                "text": "Alternar os locais de aplicação entre as paredes abdominal anterolateral e posterolateral, à direita e à esquerda."
              }
            ]
          },
