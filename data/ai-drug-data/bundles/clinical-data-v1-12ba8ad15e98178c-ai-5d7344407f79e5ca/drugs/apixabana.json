      "mc_clinical_enrichment_v1": {
        "drug_key": "apixabana",
        "schema": "medcases.clinical-enrichment.v1",
        "sections": {
          "administracao_preparo": {
            "es": [
              {
                "label": "Comprimido triturado",
                "text": "Cuando no sea posible tragar el comprimido entero, las presentaciones de 2,5 mg y 5 mg pueden triturarse y suspenderse en agua, dextrosa al 5% o jugo de manzana, o mezclarse con puré de manzana, y administrarse de inmediato por vía oral."
              },
              {
                "label": "Sonda nasogástrica",
                "text": "El comprimido triturado puede suspenderse en 60 mL de agua o dextrosa al 5% y administrarse de inmediato por sonda nasogástrica; después de la dosis, lavar la sonda con agua o dextrosa al 5% según el rotulado. Las preparaciones trituradas mantienen estabilidad hasta 4 horas en los vehículos descritos."
              }
            ],
            "pt": [
              {
                "label": "Comprimido triturado",
                "text": "Quando não for possível engolir o comprimido inteiro, as apresentações de 2,5 mg e 5 mg podem ser trituradas e suspensas em água, dextrose 5% ou suco de maçã, ou misturadas com purê de maçã, e administradas prontamente por via oral."
              },
              {
                "label": "Sonda nasogástrica",
                "text": "O comprimido triturado pode ser suspenso em 60 mL de água ou dextrose 5% e administrado prontamente por sonda nasogástrica; após a dose, lavar a sonda com água ou dextrose 5% conforme a rotulagem. Preparações trituradas mantêm estabilidade por até 4 horas nos veículos descritos."
              }
            ]
          },
